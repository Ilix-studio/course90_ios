{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./types", "node_modules/@types"],
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "*": ["src/*"],
      "@assets/*": ["assets/*"]
    }
  },
  "include": [
    "src/**/*",
    "assets/**/*",
    "types/**/*",
    "**/*.ttf",
    "**/*.d.ts",
    "AppInitializer.tsx"
  ]
}
